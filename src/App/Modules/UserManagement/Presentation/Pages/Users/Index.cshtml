@page
@model App.Modules.UserManagement.Presentation.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["PaginationExtraQuery"] = string.IsNullOrEmpty(Model.Search) ? "" : $"&Search={Uri.EscapeDataString(Model.Search)}";
}

<div class="page-header">
    <h1>Users</h1>
    <a class="btn btn-primary" asp-page="Create">New user</a>
</div>

<form method="get" class="search-form">
    <input type="search" name="Search" value="@Model.Search" placeholder="Search by email or name" class="form-control" />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<table class="data-table" id="users-table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Display name</th>
            <th>Status</th>
            <th>Roles</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users.Page.Items)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.DisplayName</td>
                <td><partial name="_StatusBadge" model="user.Status" /></td>
                <td>@string.Join(", ", user.RoleNames)</td>
                <td>@user.CreatedAtUtc.ToString("u")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@user.Id">Edit</a>
                    @{
                        var willActivate = user.Status != "Active";
                    }
                    <form method="post" asp-page="Edit" asp-page-handler="ToggleStatus"
                          asp-route-id="@user.Id" asp-route-activate="@willActivate.ToString().ToLowerInvariant()"
                          class="inline-form" data-confirm="@(willActivate ? "Activate" : "Deactivate") @user.Email?">
                        <button type="submit" class="btn btn-link">@(willActivate ? "Activate" : "Deactivate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="Model.Users.Page" />

@section Scripts {
    <script type="module" src="~/js/modules/user-management/users/index.js"></script>
}
