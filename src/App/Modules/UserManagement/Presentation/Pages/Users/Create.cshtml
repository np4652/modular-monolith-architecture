@page
@model App.Modules.UserManagement.Presentation.Pages.Users.CreateModel
@{
    ViewData["Title"] = "New user";
}

<h1>New user</h1>

<form method="post" class="entity-form">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" class="form-control" />
        <span asp-validation-for="Input.DisplayName" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
    </div>

    <fieldset class="form-group">
        <legend>Roles</legend>
        @foreach (var role in Model.AvailableRoles)
        {
            <label class="checkbox-option">
                <input type="checkbox" name="Input.RoleIds" value="@role.Id" /> @role.Name
            </label>
        }
    </fieldset>

    <button type="submit" class="btn btn-primary">Create user</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
