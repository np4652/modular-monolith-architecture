@page
@model App.Modules.UserManagement.Presentation.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create account";
}

<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />

<div class="auth-page">

    <div class="auth-container">

        <!-- =========================
             LEFT BRAND PANEL
             ========================= -->

        <div class="auth-brand-panel">

            <div class="brand">

                <div class="brand-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M12 3L20 6V11C20 16.5 16.5 20 12 21C7.5 20 4 16.5 4 11V6L12 3Z" />

                        <rect x="9"
                              y="10"
                              width="6"
                              height="5"
                              rx="1" />

                        <path d="M10 10V8.5C10 7.4 10.9 6.5 12 6.5C13.1 6.5 14 7.4 14 8.5V10" />

                    </svg>

                </div>

                <div>

                    <div class="brand-name">
                        ModularApp
                    </div>

                    <span class="brand-tagline">
                        Secure. Simple. Scalable.
                    </span>

                </div>

            </div>


            <div class="brand-content">

                <h2>
                    Join us!
                </h2>

                <div class="brand-line"></div>

                <p>
                    Create your account and
                    start using the platform.
                </p>

                <div class="security-illustration">

                    <div class="security-platform"></div>

                    <div class="security-lock"></div>

                </div>

            </div>

        </div>


        <!-- =========================
             REGISTER FORM
             ========================= -->

        <div class="auth-form-panel">

            <div class="auth-form-wrapper">

                <div class="auth-header">

                    <div class="auth-header-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <circle cx="12"
                                    cy="8"
                                    r="3.5" />

                            <path d="M5 21C5.7 16.8 8.1 14.5 12 14.5C15.9 14.5 18.3 16.8 19 21" />

                            <path d="M19 8V12" />

                            <path d="M17 10H21" />

                        </svg>

                    </div>

                    <h1>
                        Create account
                    </h1>

                    <p>
                        Enter your details to get started
                    </p>

                </div>


                <form method="post">

                    @* <div asp-validation-summary="All"
                         class="validation-summary">
                    </div> *@


                    <!-- FIRST / LAST NAME -->

                    <div style="
                        display:grid;
                        grid-template-columns:1fr 1fr;
                        gap:15px;
                        ">

                        <div class="form-group">

                            <label asp-for="Input.FirstName"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.FirstName"
                                   class="form-control"
                                   style="padding-left:16px;"
                                   placeholder="First name"
                                   autocomplete="given-name" />

                            <span asp-validation-for="Input.FirstName"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Input.LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.LastName"
                                   class="form-control"
                                   style="padding-left:16px;"
                                   placeholder="Last name"
                                   autocomplete="family-name" />

                            <span asp-validation-for="Input.LastName"
                                  class="field-validation-error">
                            </span>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="Input.Email"
                               class="form-label">
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2" />

                                    <path d="M3 7L12 13L21 7" />

                                </svg>

                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- PASSWORD -->

                    <div class="form-group">

                        <label asp-for="Input.Password"
                               class="form-label">
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="11"
                                          rx="2" />

                                    <path d="M8 10V7C8 4.8 9.8 3 12 3C14.2 3 16 4.8 16 7V10" />

                                </svg>

                            </span>

                            <input asp-for="Input.Password"
                                   id="registerPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('registerPassword', this)">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <path d="M2 12C4.5 7.5 8 5 12 5C16 5 19.5 7.5 22 12C19.5 16.5 16 19 12 19C8 19 4.5 16.5 2 12Z" />

                                    <circle cx="12"
                                            cy="12"
                                            r="3" />

                                </svg>

                            </button>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="form-group">

                        <label asp-for="Input.ConfirmPassword"
                               class="form-label">
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="11"
                                          rx="2" />

                                    <path d="M8 10V7C8 4.8 9.8 3 12 3C14.2 3 16 4.8 16 7V10" />

                                </svg>

                            </span>

                            <input asp-for="Input.ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm your password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPassword', this)">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <path d="M2 12C4.5 7.5 8 5 12 5C16 5 19.5 7.5 22 12C19.5 16.5 16 19 12 19C8 19 4.5 16.5 2 12Z" />

                                    <circle cx="12"
                                            cy="12"
                                            r="3" />

                                </svg>

                            </button>

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- TERMS -->

                    <div class="terms">

                        By creating an account, you agree to our
                        <a href="#">
                            Terms of Service
                        </a>
                        and
                        <a href="#">
                            Privacy Policy
                        </a>.

                    </div>


                    <!-- REGISTER -->

                    <button type="submit"
                            class="btn-auth">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M12 5V19" />

                            <path d="M5 12H19" />

                        </svg>

                        Create account

                    </button>

                </form>


                <!-- DIVIDER -->

                <div class="auth-divider">
                    <span>OR</span>
                </div>


                <!-- GOOGLE -->

                <button type="button"
                        class="btn-google">

                    <svg class="google-icon"
                         viewBox="0 0 24 24">

                        <path fill="#4285F4"
                              d="M21.35 12.2c0-.7-.06-1.37-.18-2H12v3.79h5.23a4.47 4.47 0 0 1-1.94 2.93v2.43h3.14c1.84-1.69 2.92-4.18 2.92-7.15Z" />

                        <path fill="#34A853"
                              d="M12 21.8c2.63 0 4.84-.87 6.45-2.36l-3.14-2.43c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.51A9.74 9.74 0 0 0 12 21.8Z" />

                        <path fill="#FBBC05"
                              d="M6.54 13.9a5.86 5.86 0 0 1 0-3.8V7.59H3.3a9.8 9.8 0 0 0 0 8.82l3.24-2.51Z" />

                        <path fill="#EA4335"
                              d="M12 6.08c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.15 14.63 2.2 12 2.2a9.74 9.74 0 0 0-8.7 5.39l3.24 2.51C7.31 7.8 9.46 6.08 12 6.08Z" />

                    </svg>

                    Sign up with Google

                </button>


                <!-- FOOTER -->

                <div class="auth-footer">

                    Already have an account?

                    <a asp-page="/Account/Login"
                       class="auth-link">
                        Sign in
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);

            if (!input) {
                return;
            }

            if (input.type === "password") {

                input.type = "text";

                button.setAttribute(
                    "aria-label",
                    "Hide password"
                );

            } else {

                input.type = "password";

                button.setAttribute(
                    "aria-label",
                    "Show password"
                );

            }

        }

    </script>
}