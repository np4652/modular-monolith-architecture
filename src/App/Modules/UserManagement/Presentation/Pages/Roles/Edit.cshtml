@page "{id:guid}"
@model App.Modules.UserManagement.Presentation.Pages.Roles.EditModel
@{
    ViewData["Title"] = "Edit role";
}

@if (Model.Role is null)
{
    <p>Role not found.</p>
}
else
{
    <h1>Edit role</h1>

    <form method="post" class="entity-form">
        <input type="hidden" asp-for="Input.RoleId" />
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Input.Name"></label>
            <input asp-for="Input.Name" class="form-control" disabled="@Model.Role.IsSystemRole" />
            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Description"></label>
            <input asp-for="Input.Description" class="form-control" />
        </div>

        <fieldset class="form-group">
            <legend>Permissions</legend>
            @foreach (var group in Model.Role.Permissions.GroupBy(p => p.Category))
            {
                <h3>@group.Key</h3>
                foreach (var permission in group)
                {
                    <label class="checkbox-option">
                        <input type="checkbox" name="Input.PermissionCodes" value="@permission.Code" checked="@permission.Selected" />
                        @permission.DisplayName
                    </label>
                }
            }
        </fieldset>

        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="Index" class="btn btn-link">Cancel</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
